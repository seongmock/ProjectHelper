# ProjectHelper 환경변수 — 이 파일을 .env 로 복사해 채운다. (.env 는 git에 올라가지 않는다)
#
#   cp .env.example .env
#
# ── HTTPS Basic 인증 ────────────────────────────────────────────────
# 해시 생성:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '새비밀번호'
#
# ⚠️ 2026-08-05 실사 지적: 이전 자격증명이 Caddyfile에 평문 커밋되어 공개 저장소의
#    git 이력(208 커밋)에 남아 있다. 파일에서 지우는 것만으로는 제거되지 않으므로
#    비밀번호를 반드시 교체할 것.
BASIC_AUTH_USER=changeme
BASIC_AUTH_HASH=

# ── 로깅 ────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
