# ProjectHelper 환경변수 — 이 파일을 .env 로 복사해 채운다. (.env 는 git에 올라가지 않는다)
#
#   cp .env.example .env
#
# ── HTTPS Basic 인증 ────────────────────────────────────────────────
# 해시 생성:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '새비밀번호'
#
# ⚠️ 2026-08-05 실사 지적: 이전 자격증명이 Caddyfile에 평문 커밋되어 공개 저장소의
#    git 이력(208 커밋)에 남아 있다. 파일에서 지우는 것만으로는 제거되지 않으므로
#    비밀번호를 반드시 교체할 것.
BASIC_AUTH_USER=changeme
BASIC_AUTH_HASH=

# ── 로깅 ────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── 앱 인증(P3-3) ─────────────────────────────────────
# Caddy basicauth 와는 별개다. 앱 계정은 화면의 [계정] 에서 첫 관리자를 만들면 켜진다
# (계정이 없으면 지금까지처럼 누구나 편집할 수 있다).
# 세션 서명 키 — 비우면 데이터 볼륨에 자동 생성·재사용한다.
PH_SESSION_SECRET=
# AI/MCP 서비스 신원: 이름:역할:토큰 (쉼표로 여러 개). 역할은 viewer|editor|admin.
# 예) PH_API_TOKENS=ai-agent:editor:$(openssl rand -hex 24)
PH_API_TOKENS=
# 앞단이 인증을 보증할 때만 1 — X-Auth-User 헤더를 신원으로 받아들인다.
PH_TRUST_PROXY_AUTH=0
