{
	# 관리 API는 쓰지 않으므로 비활성화 (불필요한 노출면 제거)
	admin off
}

:80 {
	redir https://{host}{uri}
}

:443 {
	tls internal {
		on_demand
	}

	# `route` 로 실행 순서를 명시한다 (header → encode → basic_auth → handle).
	#
	# 참고 (2026-08-05 격리 테스트로 확인한 실제 동작):
	# basic_auth 의 401 응답에는 이 header 블록이 적용되지 않는다. Caddy 가 401을
	# header 핸들러의 응답 래퍼를 거치지 않고 직접 쓰기 때문이며, route 로 순서를
	# 바꿔도 마찬가지다. 401은 본문이 없어 보호할 콘텐츠가 없으므로 문제가 아니다.
	# 인증된 200 응답에는 모든 헤더가 정상 적용되고 `-Server` 도 동작한다.
	route {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
			-Server
		}

		# HSTS는 의도적으로 넣지 않는다.
		# `tls internal`(자체서명) 환경에서 HSTS를 켜면 브라우저가 인증서 경고의
		# "무시하고 진행"을 막아버려 전 사용자가 접속 불가가 된다.
		# 사내 CA 발급 인증서로 전환한 뒤에 활성화할 것.

		# 응답 압축 — 모든 트래픽이 Caddy를 통과하므로 여기가 실질적인 압축 지점이다.
		# (실사 시점: 압축 미적용으로 307KB JS를 그대로 전송 중이었다 → gzip 약 96KB)
		encode zstd gzip

		# 자격증명은 .env 로 주입한다 (docker-compose.yml 참조).
		# 과거 이 자리에 사용자명과 bcrypt 해시가 평문 커밋돼 있었다 — 공개 저장소 기준 상시 노출.
		# 해시 생성: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '새비밀번호'
		basic_auth {
			{env.BASIC_AUTH_USER} {env.BASIC_AUTH_HASH}
		}

		handle /api/* {
			reverse_proxy project-helper-api:3000 {
				# basicauth 인증 사용자를 서버에 전달 (멀티유저 대비 — 서버는 owner/createdBy 기록에 사용).
				# header_up 은 클라이언트가 보낸 동일 헤더를 '덮어쓴다' — 신원 위조를 막는 지점이다.
				header_up X-Auth-User {http.auth.user.id}
			}
		}

		handle {
			reverse_proxy project-management-app:80
		}
	}
}
