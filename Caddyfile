{
	# 관리 API는 쓰지 않으므로 비활성화 (불필요한 노출면 제거)
	admin off

	# SNI 없는 접속에 어떤 인증서를 줄지 정한다. 이것이 없으면 브라우저로 접속이 안 된다.
	#
	# 2026-08-18 규명: 브라우저는 **IP 주소로 접속할 때 SNI 를 보내지 않는다**(RFC 6066 —
	# SNI 에는 호스트명만 담을 수 있다). SNI 가 없으면 아래 `on_demand` 는 발급할 이름을
	# 알 수 없어 **연결의 로컬 주소**로 발급하는데, Caddy 는 docker 네트워크 안에 있으므로
	# 그 주소가 컨테이너 IP(`172.18.0.4`)다. 그래서 브라우저는 `IP:172.18.0.4` 인증서를
	# 받고, 주소창의 10.178.21.120 과 이름이 맞지 않아 ERR_CERT_COMMON_NAME_INVALID 로
	# 거부했다. `curl`/`openssl -servername` 은 SNI 를 보내므로 정상 동작해서, 스크립트
	# 검증은 전부 통과하는데 사람이 브라우저로는 들어갈 수 없는 상태였다.
	# CA 를 신뢰 저장소에 등록해도 이 오류는 사라지지 않는다 — 신뢰와 이름 검증은 별개다.
	#
	# 실측(격리 컨테이너): 적용 후 SNI 없는 연결 → `IP:10.178.21.120`,
	# SNI 를 보내는 연결 → 그 이름의 인증서(on_demand 동작 유지).
	# 서버를 옮기면 이 기본값을 고치거나, caddy 컨테이너에 `SITE_HOST` 를 넣어 덮어쓴다.
	# (compose 에는 일부러 넣지 않았다 — 빈 문자열이 주입되면 default_sni 가 비어 기동이 깨진다.)
	default_sni {$SITE_HOST:10.178.21.120}
}

:80 {
	redir https://{host}{uri}
}

:443 {
	tls internal {
		on_demand
	}

	# `route` 로 실행 순서를 명시한다 (header → encode → basic_auth → handle).
	#
	# 참고 (2026-08-05 격리 테스트로 확인한 실제 동작):
	# basic_auth 의 401 응답에는 이 header 블록이 적용되지 않는다. Caddy 가 401을
	# header 핸들러의 응답 래퍼를 거치지 않고 직접 쓰기 때문이며, route 로 순서를
	# 바꿔도 마찬가지다. 401은 본문이 없어 보호할 콘텐츠가 없으므로 문제가 아니다.
	# 인증된 200 응답에는 모든 헤더가 정상 적용되고 `-Server` 도 동작한다.
	route {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
			-Server
		}

		# HSTS는 의도적으로 넣지 않는다.
		# `tls internal`(자체서명) 환경에서 HSTS를 켜면 브라우저가 인증서 경고의
		# "무시하고 진행"을 막아버려 전 사용자가 접속 불가가 된다.
		# 사내 CA 발급 인증서로 전환한 뒤에 활성화할 것.

		# 응답 압축 — 모든 트래픽이 Caddy를 통과하므로 여기가 실질적인 압축 지점이다.
		# (실사 시점: 압축 미적용으로 307KB JS를 그대로 전송 중이었다 → gzip 약 96KB)
		encode zstd gzip

		# ⚠️ 2026-08-18: **basicauth 를 일시적으로 제거한 상태다** (사용자 결정 —
		# 개선 작업이 끝난 뒤 다시 붙인다). 그때까지 이 사이트는 회사망에 있는 누구나
		# **인증 없이 타임라인 데이터 전체를 읽고 쓸 수 있다.** 의도된 상태이며,
		# `scripts/verify-deploy.sh` 가 이 파일을 읽어 어느 상태인지 판정해 보고한다.
		#
		# 복구는 아래 네 줄을 되살리면 끝난다 — 자격증명은 `.env` 에 그대로 있고
		# (BASIC_AUTH_USER/HASH, docker-compose.yml 이 주입한다) 비밀번호를 분실했으면
		# `./scripts/rotate-password.sh` 로 재발급한다(해시는 되돌릴 수 없다):
		#
		#     @needs_auth not path /api/health
		#     basic_auth @needs_auth {
		#         {env.BASIC_AUTH_USER} {env.BASIC_AUTH_HASH}
		#     }
		#
		# 함께 되돌릴 것이 둘 있다. ① 아래 `header_up X-Auth-User` 를 `{http.auth.user.id}` 로
		# 되돌린다. ② **api 컨테이너에 `PH_TRUST_PROXY_AUTH=1` 을 준다**(docker-compose.yml).
		# 검증 스크립트는 자동 판정하므로 손댈 필요가 없다.
		#
		# ②가 필요해진 이유 (2026-08-19, P3-3): 이제 **앱 자체에 계정과 역할이 있다**
		# (`server/lib/auth.js`). 계정이 하나도 없으면 잠들어 있고, 첫 관리자를 만드는 순간
		# 앱이 스스로 로그인을 요구한다. 그 상태에서 basicauth 를 그냥 되살리면 사용자는
		# **비밀번호 창을 두 번** 본다(Caddy 것 하나, 앱 것 하나). `PH_TRUST_PROXY_AUTH=1` 을
		# 켜면 Caddy 가 인증한 이름이 그대로 앱의 신원이 되어 앱은 다시 묻지 않는다
		# (그 이름의 계정이 앱에 없으면 역할은 `PH_PROXY_ROLE`, 기본 editor).
		# 그 스위치를 켜지 않은 채 헤더만 보내면 서버는 헤더를 **무시한다** — 켜지 않았는데
		# 믿으면 클라이언트가 `X-Auth-User: admin` 을 직접 붙여 아무나 관리자가 되기 때문이다.
		#
		# 되살릴 때 다시 필요해지는 지식 — **`/api/health` 만 인증에서 제외했던 이유**:
		# basic_auth 의 401 응답에는 위 header 블록이 적용되지 않으므로(Caddy 동작, route 로
		# 순서를 바꿔도 마찬가지), 자격증명이 없으면 검사할 수 있는 200 응답이 하나도 없었다.
		# 그래서 보안 헤더·-Server·HSTS 검사는 비밀번호를 아는 사람만 돌릴 수 있었고 자동
		# 검증에서는 통째로 skip 됐다. `path` 는 정확 일치이며(접두어·하위 경로가 아니다)
		# 노출되는 것은 `{ok:true, time}` 뿐이었다. **그 매처를 넓히지 마라** —
		# `/api/*` 를 제외로 만들면 데이터 전체가 열린다.
		#
		# 과거 이 자리에 사용자명과 bcrypt 해시가 평문 커밋돼 있었다 — 공개 저장소 기준 상시
		# 노출이었다. 해시를 이 파일에 다시 하드코딩하지 마라.

		handle /api/* {
			reverse_proxy project-helper-api:3000 {
				# 인증이 없는 동안에도 신원 헤더는 **고정값으로 덮어쓴다.**
				# `header_up` 은 클라이언트가 보낸 동일 헤더를 덮어쓰는 지점이다 —
				# 인증이 없으면 `{http.auth.user.id}` 는 빈 값이고, 빈 값을 넣으면 Caddy 가
				# 헤더를 지워 **클라이언트가 X-Auth-User 를 스스로 붙여 감사 로그의 actor 를
				# 위조**할 수 있게 된다. 'noauth' 로 고정하면 events.jsonl 에서 무인증 기간의
				# 쓰기가 한눈에 구분된다.
				# (2026-08-19 이후 서버는 `PH_TRUST_PROXY_AUTH=1` 일 때만 이 헤더를 신원으로
				# 받아들인다. 즉 지금은 이 값이 감사 로그의 표식일 뿐 권한을 주지 않는다 —
				# 그래도 고정해 둔다. 그 스위치를 켠 순간 위조 경로가 되살아나기 때문이다.)
				header_up X-Auth-User noauth
			}
		}

		handle {
			reverse_proxy project-management-app:80
		}
	}
}
