{
	# 관리 API는 쓰지 않으므로 비활성화 (불필요한 노출면 제거)
	admin off

	# SNI 없는 접속에 어떤 인증서를 줄지 정한다. 이것이 없으면 브라우저로 접속이 안 된다.
	#
	# 2026-08-18 규명: 브라우저는 **IP 주소로 접속할 때 SNI 를 보내지 않는다**(RFC 6066 —
	# SNI 에는 호스트명만 담을 수 있다). SNI 가 없으면 아래 `on_demand` 는 발급할 이름을
	# 알 수 없어 **연결의 로컬 주소**로 발급하는데, Caddy 는 docker 네트워크 안에 있으므로
	# 그 주소가 컨테이너 IP(`172.18.0.4`)다. 그래서 브라우저는 `IP:172.18.0.4` 인증서를
	# 받고, 주소창의 10.178.21.120 과 이름이 맞지 않아 ERR_CERT_COMMON_NAME_INVALID 로
	# 거부했다. `curl`/`openssl -servername` 은 SNI 를 보내므로 정상 동작해서, 스크립트
	# 검증은 전부 통과하는데 사람이 브라우저로는 들어갈 수 없는 상태였다.
	# CA 를 신뢰 저장소에 등록해도 이 오류는 사라지지 않는다 — 신뢰와 이름 검증은 별개다.
	#
	# 실측(격리 컨테이너): 적용 후 SNI 없는 연결 → `IP:10.178.21.120`,
	# SNI 를 보내는 연결 → 그 이름의 인증서(on_demand 동작 유지).
	# 서버를 옮기면 이 기본값을 고치거나, caddy 컨테이너에 `SITE_HOST` 를 넣어 덮어쓴다.
	# (compose 에는 일부러 넣지 않았다 — 빈 문자열이 주입되면 default_sni 가 비어 기동이 깨진다.)
	default_sni {$SITE_HOST:10.178.21.120}
}

:80 {
	redir https://{host}{uri}
}

:443 {
	tls internal {
		on_demand
	}

	# `route` 로 실행 순서를 명시한다 (header → encode → basic_auth → handle).
	#
	# 참고 (2026-08-05 격리 테스트로 확인한 실제 동작):
	# basic_auth 의 401 응답에는 이 header 블록이 적용되지 않는다. Caddy 가 401을
	# header 핸들러의 응답 래퍼를 거치지 않고 직접 쓰기 때문이며, route 로 순서를
	# 바꿔도 마찬가지다. 401은 본문이 없어 보호할 콘텐츠가 없으므로 문제가 아니다.
	# 인증된 200 응답에는 모든 헤더가 정상 적용되고 `-Server` 도 동작한다.
	route {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
			-Server
		}

		# HSTS는 의도적으로 넣지 않는다.
		# `tls internal`(자체서명) 환경에서 HSTS를 켜면 브라우저가 인증서 경고의
		# "무시하고 진행"을 막아버려 전 사용자가 접속 불가가 된다.
		# 사내 CA 발급 인증서로 전환한 뒤에 활성화할 것.

		# 응답 압축 — 모든 트래픽이 Caddy를 통과하므로 여기가 실질적인 압축 지점이다.
		# (실사 시점: 압축 미적용으로 307KB JS를 그대로 전송 중이었다 → gzip 약 96KB)
		encode zstd gzip

		# 자격증명은 .env 로 주입한다 (docker-compose.yml 참조).
		# 과거 이 자리에 사용자명과 bcrypt 해시가 평문 커밋돼 있었다 — 공개 저장소 기준 상시 노출.
		# 해시 생성: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '새비밀번호'
		#
		# /api/health 만 인증에서 제외한다 (`path` 는 정확 일치 — 접두어나 하위 경로가 아니다).
		# 이유: basic_auth 의 401 응답에는 위 header 블록이 적용되지 않으므로(Caddy 동작),
		# 자격증명이 없으면 검사할 수 있는 200 응답이 하나도 없었다. 그래서 보안 헤더·-Server·
		# HSTS 검사는 비밀번호를 아는 사람만 돌릴 수 있었고 자동 검증에서는 통째로 skip 됐다.
		# 노출되는 것은 `{ok:true, time}` 뿐이다 — 타임라인 데이터 경로는 전부 인증 뒤에 남는다.
		# 이 매처를 넓히지 마라. /api/* 를 제외로 만들면 데이터 전체가 열린다.
		@needs_auth not path /api/health
		basic_auth @needs_auth {
			{env.BASIC_AUTH_USER} {env.BASIC_AUTH_HASH}
		}

		handle /api/* {
			reverse_proxy project-helper-api:3000 {
				# basicauth 인증 사용자를 서버에 전달 (멀티유저 대비 — 서버는 owner/createdBy 기록에 사용).
				# header_up 은 클라이언트가 보낸 동일 헤더를 '덮어쓴다' — 신원 위조를 막는 지점이다.
				header_up X-Auth-User {http.auth.user.id}
			}
		}

		handle {
			reverse_proxy project-management-app:80
		}
	}
}
